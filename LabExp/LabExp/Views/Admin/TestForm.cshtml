@{
    ViewData["Title"] = Model.TestId == Guid.Empty ? "Add Test" : "Edit Test";
    Layout = "_AdminLayout";
}

@model LabExp.Models.AdminModels.TestFormViewModel

<div class="container mt-4">

    <h2 class="mb-4">@ViewData["Title"]</h2>


    <form asp-action="@(Model.TestId == Guid.Empty ? "AddTest" : "EditTest")"
          method="post">

        <input asp-for="TestId" type="hidden" />

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>

        <!-- Test name -->
        <div class="mb-3">

            <label asp-for="Name"
                   class="form-label">
                Test Name
            </label>

            <input asp-for="Name"
                   class="form-control" />

            <span asp-validation-for="Name"
                  class="text-danger">
            </span>

        </div>



        <!-- Subject dropdown -->
        <div class="mb-3">

            <label class="form-label">
                Subject
            </label>


            <select asp-for="SubjectId"
                    class="form-select"
                    id="subjectSelect">


                @foreach (var s in Model.Subjects)
                {
                    <option value="@s.SubjectId">
                        @s.Name
                    </option>
                }


            </select>


            <span asp-validation-for="SubjectId"
                  class="text-danger">
            </span>

        </div>



        <!-- Status dropdown -->
        <div class="mb-3">

            <label class="form-label">
                Status
            </label>


            <select asp-for="StatusId"
                    class="form-select"
                    id="statusSelect">


                @foreach (var st in Model.Statuses)
                {
                    <option value="@st.StatusId">
                        @st.Name
                    </option>
                }


            </select>


            <span asp-validation-for="StatusId"
                  class="text-danger">
            </span>

        </div>



        <!-- Substance dropdown -->
        <div class="mb-3">

            <label class="form-label">
                Substance
            </label>


            <select asp-for="SubstanceId"
                    class="form-select"
                    id="substanceSelect">


                @foreach (var s in Model.Substances)
                {
                    <option value="@s.SubstanceId">
                        @s.Name - @(s.Severity?.SeverityName)
                    </option>
                }


            </select>


            <span asp-validation-for="SubstanceId"
                  class="text-danger">
            </span>

        </div>



        <!-- Scientists -->
        <div class="mb-3">

            <label class="form-label">
                Scientists
            </label>


            <select asp-for="ScientistIds"
                    class="form-select"
                    id="scientistSelect"
                    multiple>


                @foreach (var s in Model.Scientists)
                {
                    <option value="@s.Id">
                        @s.UserName - @s.Clearance.LevelName
                    </option>
                }


            </select>


            <span asp-validation-for="ScientistIds"
                  class="text-danger">
            </span>


        </div>



        <!-- Description -->
        <div class="mb-3">

            <label asp-for="Description"
                   class="form-label">
                Description
            </label>


            <textarea asp-for="Description"
                      class="form-control"
                      rows="6"
                      placeholder="Write test description here...">
            </textarea>


            <span asp-validation-for="Description"
                  class="text-danger">
            </span>


        </div>




        <div class="d-flex justify-content-between">


            <a asp-action="ManageTests"
               class="btn btn-secondary">
                ← Go Back
            </a>



            <button type="submit"
                    class="btn btn-success">

                @(Model.TestId == Guid.Empty
                    ? "Create Test"
                    : "Save Changes")

            </button>


        </div>


    </form>


</div>



@section Scripts
{
    <partial name="_ValidationScriptsPartial" />


    <!-- Script for validation -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/4.0.0/jquery.validate.unobtrusive.min.js"></script>

    <!-- Modern search instead of comboboxes -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        $(document).ready(function () {

        $('#scientistSelect').select2({
        placeholder: "Search and select scientists",
        width: '100%'
        });

        $('#substanceSelect').select2({
        placeholder: "Search substance...",
        width: '100%'
        });

        $('#subjectStatusSelect').select2({
        placeholder: "Select a status...",
        width: '100%'
        });

        $('#subjectSelect').select2({
        placeholder: "Search subject...",
        width: '100%'
        });

        });
    </script>
}