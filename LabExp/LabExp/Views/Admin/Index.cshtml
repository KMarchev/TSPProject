@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "_AdminLayout";
}
@model LabExp.Models.AdminModels.AdminDashboardViewModel

<h2 class="mb-4">
    Admin Dashboard
</h2>

<div class="row">

    <div class="col-md-3 mb-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5>Scientists</h5>
                <h1>@Model.TotalScientists</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5>Subjects</h5>
                <h1>@Model.TotalSubjects</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <h5>Tests</h5>
                <h1>@Model.TotalTests</h1>
            </div>
        </div>
    </div>

    <div class="col-md-3 mb-3">
        <div class="card bg-danger text-white">
            <div class="card-body">
                <h5>Substances</h5>
                <h1>@Model.TotalSubstances</h1>
            </div>
        </div>
    </div>

</div>

<div class="row">

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                Statuses
            </div>
            <div class="card-body text-center">
                <h2>@Model.TotalStatuses</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                Severity Levels
            </div>
            <div class="card-body text-center">
                <h2>@Model.TotalSeverities</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card">
            <div class="card-header">
                Clearance Levels
            </div>
            <div class="card-body text-center">
                <h2>@Model.TotalClearances</h2>
            </div>
        </div>
    </div>

</div>

<hr/>

<div class="card mt-4">

    <div class="card-header">
        Recent Tests
    </div>

    <table class="table table-striped mb-0">

        <thead>
            <tr>
                <th>#</th>
                <th>Test</th>
                <th>Subject</th>
                <th>Substance</th>
            </tr>
        </thead>

        <tbody>

        @foreach(var item in Model.RecentTests)
        {
            <tr>
                <td>@item.Number</td>
                <td>@item.TestName</td>
                <td>@item.Subject</td>
                <td>@item.Substance</td>
            </tr>
        }

        </tbody>

    </table>

</div>